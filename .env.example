# F.R.I.D.A.Y. — Environment Configuration

# ── ChatGPT (OpenAI) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Active AI backend (default) ───────────────────────────────────────────────
# Options: piai | gemini | chatgpt | claude
# piai    → Pi.ai via browser session (free, no API key needed)
# gemini  → Google Gemini (uses GEMINI_API_KEY if set, else browser session)
# chatgpt → ChatGPT (uses OPENAI_API_KEY if set, else browser session)
# claude  → Claude via browser session
ACTIVE_AI=piai
